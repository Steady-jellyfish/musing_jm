{
  "mcpServers": {
    "knowledge-base": {
      "command": "npx",
      "args": ["tsx", "src/mcp-servers/knowledge-base/index.ts"],
      "env": {
        "KB_DB_HOST": "${KB_DB_HOST}",
        "KB_DB_PORT": "${KB_DB_PORT}",
        "KB_DB_NAME": "${KB_DB_NAME}",
        "KB_DB_USER": "${KB_DB_USER}",
        "KB_DB_PASSWORD": "${KB_DB_PASSWORD}"
      }
    },
    "member-db": {
      "command": "npx",
      "args": ["tsx", "src/mcp-servers/member-db/index.ts"],
      "env": {
        "MEMBER_DB_HOST": "${MEMBER_DB_HOST}",
        "MEMBER_DB_PORT": "${MEMBER_DB_PORT}",
        "MEMBER_DB_NAME": "${MEMBER_DB_NAME}",
        "MEMBER_DB_USER": "${MEMBER_DB_USER}",
        "MEMBER_DB_PASSWORD": "${MEMBER_DB_PASSWORD}"
      }
    },
    "history": {
      "command": "npx",
      "args": ["tsx", "src/mcp-servers/history/index.ts"],
      "env": {
        "HISTORY_DB_HOST": "${HISTORY_DB_HOST}",
        "HISTORY_DB_PORT": "${HISTORY_DB_PORT}",
        "HISTORY_DB_NAME": "${HISTORY_DB_NAME}",
        "HISTORY_DB_USER": "${HISTORY_DB_USER}",
        "HISTORY_DB_PASSWORD": "${HISTORY_DB_PASSWORD}"
      }
    }
  }
}
