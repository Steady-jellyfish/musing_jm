# ──────────────────────────────────────────────
# Musing_jm 환경 변수 예시
# 실제 값은 .env 파일에 작성하고, .env는 절대 커밋하지 마세요.
# ──────────────────────────────────────────────

# ── 회원사 DB 접속 정보 (member-db-mcp) ──
# 실제 운영 시 회원사별로 별도 분리 예정
MEMBER_DB_HOST=localhost
MEMBER_DB_PORT=5432
MEMBER_DB_NAME=member_db
MEMBER_DB_USER=readonly_user
MEMBER_DB_PASSWORD=your_password_here

# ── 지식베이스 DB / 경로 (knowledge-base-mcp) ──
KB_DB_HOST=localhost
KB_DB_PORT=5432
KB_DB_NAME=knowledge_base
KB_DB_USER=kb_reader
KB_DB_PASSWORD=your_password_here

# ── 처리 이력 DB (history-mcp) ──
HISTORY_DB_HOST=localhost
HISTORY_DB_PORT=5432
HISTORY_DB_NAME=history_db
HISTORY_DB_USER=history_reader
HISTORY_DB_PASSWORD=your_password_here

# ── Claude API (orchestrator) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── 서버 설정 ──
NODE_ENV=development
LOG_LEVEL=debug
