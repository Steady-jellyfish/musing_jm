# ──────────────────────────────────────────────
# Musing_jm 환경 변수 예시
# 실제 값은 .env 파일에 작성하고, .env는 절대 커밋하지 마세요.
# ──────────────────────────────────────────────

# ── 서버 설정 ──
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# ── Claude API ──
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOOL_LOOPS=10
CLAUDE_TIMEOUT_MS=60000

# ── Mock 컨텍스트 (기본: false, true 설정 시 kb/member-db/history Mock 데이터를 사전 컨텍스트로 주입) ──
USE_MOCK_CONTEXT=false

# ── ERP Git 저장소 (Git URL 기반, Git Credential Manager 인증 사용) ──
ERP_GIT_URL=https://github.com/your-org/erp-repo.git
ERP_GIT_BRANCH=main
ERP_GIT_CACHE_DIR=./.cache/repos   # 기본값. 변경 시 .gitignore에도 추가 필요

# ── ERP MariaDB 접속 정보 (읽기 전용 계정 필수) ──
ERP_DB_HOST=
ERP_DB_PORT=3306
ERP_DB_NAME=
ERP_DB_USER=
ERP_DB_PASSWORD=
ERP_DB_QUERY_TIMEOUT_MS=30000

# ── 회원사 DB 접속 정보 (member-db-mcp) ──
MEMBER_DB_HOST=localhost
MEMBER_DB_PORT=5432
MEMBER_DB_NAME=member_db
MEMBER_DB_USER=readonly_user
MEMBER_DB_PASSWORD=your_password_here

# ── 지식베이스 DB (knowledge-base-mcp) ──
KB_DB_HOST=localhost
KB_DB_PORT=5432
KB_DB_NAME=knowledge_base
KB_DB_USER=kb_reader
KB_DB_PASSWORD=your_password_here

# ── 처리 이력 DB (history-mcp) ──
HISTORY_DB_HOST=localhost
HISTORY_DB_PORT=5432
HISTORY_DB_NAME=history_db
HISTORY_DB_USER=history_reader
HISTORY_DB_PASSWORD=your_password_here
