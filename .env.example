# ──────────────────────────────────────────────
# Musing_jm 환경 변수 예시
# 실제 값은 .env 파일에 작성하고, .env는 절대 커밋하지 마세요.
# ──────────────────────────────────────────────

# ── 서버 설정 ──
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# ── Claude API ──
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOOL_LOOPS=10
CLAUDE_TIMEOUT_MS=60000

# ── Mock 컨텍스트 (기본: false, true 설정 시 kb/member-db/history Mock 데이터를 사전 컨텍스트로 주입) ──
USE_MOCK_CONTEXT=false

# ── Sandbox (과제용, 추후 제거) ──
# true로 설정하면 GET /pompompurin 등 sandbox 라우트가 활성화됩니다.
ENABLE_SANDBOX=false

# ── Git/DB 공통 설정 ──
GIT_CACHE_DIR=./.cache/repos       # 기본값. .cache/ 는 .gitignore에 포함됨
GIT_SYNC_RETRY_INTERVAL_MS=300000  # 재시도 간격 ms (기본 5분)
GIT_SYNC_MAX_RETRIES=3             # 최대 재시도 횟수 (기본 3회)
DB_QUERY_TIMEOUT_MS=30000          # DB 쿼리 타임아웃 (전 회원사 공통)

# ══════════════════════════════════════════════
# 회원사별 Git 저장소 + DB 설정
# ══════════════════════════════════════════════
# 네이밍 규칙: {회원사}_{시스템}_GIT_URL  / {회원사}_{시스템}_GIT_BRANCH
#              {회원사}_{시스템}_DB_HOST  / _PORT / _NAME / _USER / _PASSWORD
# ══════════════════════════════════════════════

# ── 한화라이프랩 ERP ──
HANWHA_ERP_GIT_URL=                # Git HTTP URL (필수)
HANWHA_ERP_GIT_BRANCH=main         # 브랜치 (필수)
HANWHA_ERP_DB_HOST=                # MariaDB 호스트
HANWHA_ERP_DB_PORT=3306
HANWHA_ERP_DB_NAME=                # 데이터베이스명
HANWHA_ERP_DB_USER=                # 읽기 전용 계정
HANWHA_ERP_DB_PASSWORD=

# ── 회원사/시스템 추가 시: repos.json에 항목 추가 + 여기에 환경변수 추가 ──
# HANWHA_CMS_GIT_URL=
# HANWHA_CMS_GIT_BRANCH=main
# HANWHA_CMS_DB_HOST=
# HANWHA_CMS_DB_PORT=3306
# HANWHA_CMS_DB_NAME=
# HANWHA_CMS_DB_USER=
# HANWHA_CMS_DB_PASSWORD=

# ── 공용 서비스 DB (회원사 무관, 현재 Mock) ─────
MEMBER_DB_HOST=localhost
MEMBER_DB_PORT=5432
MEMBER_DB_NAME=member_db
MEMBER_DB_USER=
MEMBER_DB_PASSWORD=

KB_DB_HOST=localhost
KB_DB_PORT=5432
KB_DB_NAME=knowledge_base
KB_DB_USER=
KB_DB_PASSWORD=

HISTORY_DB_HOST=localhost
HISTORY_DB_PORT=5432
HISTORY_DB_NAME=history_db
HISTORY_DB_USER=
HISTORY_DB_PASSWORD=
